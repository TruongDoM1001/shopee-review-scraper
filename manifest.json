{
  "manifest_version": 3,
  "name": "Shopee Review Scraper",
  "version": "1.0.0",
  "description": "Lấy dữ liệu comment/feedback khách hàng từ sản phẩm Shopee",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://shopee.vn/*", "https://www.shopee.vn/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Review Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*", "https://www.shopee.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
